# Environment Configuration Example
# Copy this file to .env and update with your actual values

# ============================================
# Application
# ============================================
NODE_ENV=development
APP_NAME=TalkToEarn

# ============================================
# Database
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=talktoearn
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=talktoearn_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ============================================
# Redis
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ============================================
# Kafka
# ============================================
KAFKA_BROKERS=localhost:9093
KAFKA_CLIENT_ID=talktoearn

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your_very_secure_jwt_secret_change_this_in_production
JWT_REFRESH_SECRET=your_very_secure_refresh_secret_change_this_in_production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# AWS / S3 (or MinIO for dev)
# ============================================
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_CHAT=chat-attachments
S3_BUCKET_PROFILE=profile-photos
S3_BUCKET_STATUS=status-media

# ============================================
# External Services
# ============================================

# SMS Provider (Twilio, AWS SNS, etc.)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Provider (SendGrid, AWS SES, etc.)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@talktoearn.com

# Push Notifications
FCM_SERVER_KEY=your_firebase_server_key
FCM_PROJECT_ID=your_firebase_project_id

# ============================================
# Service Ports
# ============================================
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=3001
CHAT_SERVICE_PORT=3002
USER_SERVICE_PORT=3003
REWARD_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
ENGAGEMENT_SERVICE_PORT=8001

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Security
# ============================================
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_change_this_in_production
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============================================
# Monitoring
# ============================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ============================================
# Feature Flags
# ============================================
ENABLE_ENGAGEMENT_ENGINE=true
ENABLE_FRAUD_DETECTION=true
ENABLE_SEMANTIC_DUPLICATE_DETECTION=false
ENABLE_CALL_FEATURES=true
ENABLE_STATUS_FEATURES=true
ENABLE_COUPLE_FEATURES=true

# ============================================
# Points & Rewards Configuration
# ============================================
DAILY_POINTS_CAP_DEFAULT=500
DAILY_POINTS_CAP_HIGH_REP=1000
MESSAGE_RATE_LIMIT_PER_MINUTE=30
CALL_RATE_LIMIT_PER_HOUR=10

# ============================================
# Development
# ============================================
DEBUG=true
LOG_LEVEL=debug
ENABLE_API_DOCS=true
