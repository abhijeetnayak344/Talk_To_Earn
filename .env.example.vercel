# Vercel Environment Variables
# Add these to your Vercel project settings

# Database (Use Vercel Postgres, Neon, Supabase, or any PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Secrets
JWT_SECRET=your_very_secure_jwt_secret_change_in_production
JWT_REFRESH_SECRET=your_very_secure_refresh_secret_change_in_production

# Optional: Redis (Use Upstash Redis for Vercel)
REDIS_URL=redis://default:password@host:6379

# Environment
NODE_ENV=production
